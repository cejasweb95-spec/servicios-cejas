{
  "name": "cejas-internacionales",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test tests/a11y",
    "test:crossbrowser": "playwright test -c playwright.crossbrowser.config.ts",
    "test:seo": "playwright test tests/e2e/seo.spec.ts",
    "test:seo:all": "node scripts/audit-seo.mjs",
    "test:responsive:all": "node scripts/audit-responsive.mjs",
    "test:visual": "playwright test tests/visual",
    "test:links": "node scripts/check-links.mjs",
    "test:lighthouse": "echo \"Lighthouse/PageSpeed se ejecutara cuando existan pantallas finales.\"",
    "git:push": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/git-push-remote.ps1",
    "vercel:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/vercel-deploy-prod.ps1"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.9",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-tabs": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.20.0",
    "motion": "^12.40.0",
    "next": "16.2.9",
    "next-intl": "^4.13.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
